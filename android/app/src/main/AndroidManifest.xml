<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- A chat app: the API and the gateway, in every build, release included. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Voice notes, and voice rooms and calls. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- The camera in voice rooms and calls; a phone without one still
         installs the app. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <!-- Voice and calls: WebRTC routes the sound (loudspeaker, earpiece,
         headsets) and follows the network through a change. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- A Bluetooth headset in a call: asked for on Android 12 and later,
         granted before. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <!-- The foreground service that keeps voice going with the phone locked
         or another app open (its type: the microphone), its notification,
         and its wake and Wi-Fi locks. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <!-- A screen share's own foreground service (ScreenCaptureService), started
         after the consent: the screen capture runs only under one. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>
    <!-- Voice notes in Android's media controls (audio_service): their
         foreground service plays media. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- flutter_background asks to skip battery optimizations only when told
         to, and the app never does. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" tools:node="remove"/>
    <!-- Saving a photo to the gallery on Android 9 and older. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29"/>
    <application
        android:label="duvet"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher_violet">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Duvet's own links: duvet:// and duvet.chat invites and messages. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="duvet"/>
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="duvet.chat" android:pathPrefix="/invite"/>
                <data android:scheme="https" android:host="duvet.chat" android:pathPrefix="/channels/"/>
                <data android:scheme="https" android:host="duvet.chat" android:pathPrefix="/conversations/"/>
                <data android:scheme="https" android:host="duvet.chat" android:pathPrefix="/verify"/>
                <data android:scheme="https" android:host="duvet.chat" android:pathPrefix="/reset-password"/>
                <data android:scheme="https" android:host="duvet.chat" android:pathPrefix="/change-email"/>
            </intent-filter>
        </activity>
        <!-- The launcher's entries, one for each icon to pick in Appearance
             (LauncherIcon.kt): the violet one unless the black one is on. Both
             open MainActivity, which keeps the links. -->
        <activity-alias
            android:name=".IconViolet"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_violet"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconBlack"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <!-- Changes the launcher icon picked once the app is swiped away, which
             it outlives for that (LauncherIcon.kt). -->
        <service
            android:name=".LauncherIconService"
            android:stopWithTask="false"
            android:exported="false"/>
        <!-- Keeps voice going in the background (flutter_background): started
             once the microphone is granted, stopped when the voice ends or the
             app is swiped away. -->
        <service
            android:name="de.julianassmann.flutter_background.IsolateHolderService"
            android:exported="false"
            android:foregroundServiceType="microphone"/>
        <!-- Screen sharing in voice: started between the consent and the capture,
             stopped with the share (chat.duvet/screen in MainActivity), or with
             the app when it is swiped away during one. -->
        <service
            android:name=".ScreenCaptureService"
            android:stopWithTask="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection"/>
        <!-- A voice note playing, in the media notification and quick settings
             (audio_service, through VoiceNoteHandler), and the headset's
             play/pause buttons. -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService"/>
            </intent-filter>
        </service>
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON"/>
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
