<?xml version="1.0" encoding="utf-8"?>
<!-- Launch splash up to Android 11: the ghost on the icon's ground. 12+ draws its own (values-v31).
     The size is ignored before API 23, which draws the foreground at its own 108dp. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item
        android:width="144dp"
        android:height="144dp"
        android:drawable="@drawable/launch_ghost"
        android:gravity="center" />
</layer-list>
